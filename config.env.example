# Copy to config.env (gitignored) and fill in. Every script sources it.

# --- Tanzu Platform ---
# The org and space for the test MCP server. You must be logged in with
# `cf login` and able to push apps and create services there.
CF_ORG=my-org
CF_SPACE=mcp-demo
# The shared apps domain. The echo server gets https://<ECHO_APP>.<APPS_DOMAIN>.
APPS_DOMAIN=apps.example.com
ECHO_APP=echo-mcp
# The mcp-gateway service instance, and the name the server gets in it.
# Agents call https://<gateway route>/<GATEWAY_SERVER_NAME>/mcp.
GATEWAY_NAME=mcp-gw
GATEWAY_SERVER_NAME=echo

# --- AgentMinder ---
# The tenant URL: token endpoint is $AM_TENANT_URL/oauth2/v1/token.
AM_TENANT_URL=https://agentminder.example.com/default
# A tenant admin client (client_credentials). It creates the resource
# server, the agent client and the policy. Keep these out of git.
AM_ADMIN_CLIENT_ID=
AM_ADMIN_CLIENT_SECRET=
# Prefix for the AgentMinder object names, so a second run doesn't collide.
AM_PREFIX=demo

# --- TLS ---
# A CA bundle that signs the AgentMinder and apps certificates, for the
# scripts on your workstation. Leave empty to use the system trust store.
CA_FILE=
# 1 skips certificate checks in the scripts and tells AgentMinder not to
# verify the echo server's certificate. For a lab with self-signed certs only.
INSECURE=0
